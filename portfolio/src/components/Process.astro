---
import SectionHead from './SectionHead.astro';
import { getContent, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = getContent(lang).process;
---
<section id="process" class="scroll-mt-20 border-y border-line bg-surface/40 py-24">
  <div class="container-x reveal">
    <SectionHead eyebrow={t.eyebrow} title={t.title} />
    <ol class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {t.steps.map((s) => (
        <li class="bg-surface p-7">
          <span class="font-display text-sm font-extrabold text-accent">{s.n}</span>
          <h3 class="mt-3 font-display text-base font-bold">{s.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
