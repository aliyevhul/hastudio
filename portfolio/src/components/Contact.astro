---
import SectionHead from './SectionHead.astro';
import { getContent, site, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = getContent(lang).contact;
---
<section id="contact" class="scroll-mt-20 border-t border-line bg-surface/40 py-24">
  <div class="container-x grid gap-12 reveal lg:grid-cols-[1fr_1.1fr]">
    <div>
      <SectionHead eyebrow={t.eyebrow} title={t.title} lede={t.lede} />
      <p class="mt-10 text-sm font-semibold">{t.direct}</p>
      <div class="mt-4 flex flex-col gap-3 text-sm">
        <a href={`mailto:${site.email}`} class="text-muted transition-colors hover:text-accent">{site.email}</a>
        <a href={`tel:${site.phoneHref}`} class="text-muted transition-colors hover:text-accent">{site.phone}</a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="text-muted transition-colors hover:text-accent">WhatsApp</a>
      </div>
    </div>

    <!-- No backend yet: this opens the visitor's mail app. Swap the handler
         for Formspree / Web3Forms when you want real form submissions. -->
    <form id="contactForm" class="rounded-2xl border border-line bg-surface p-7">
      <label class="block text-sm font-medium" for="cf-name">{t.form.name}</label>
      <input id="cf-name" name="name" required
        class="mt-2 w-full rounded-lg border border-line bg-ink px-4 py-3 text-sm outline-none transition-colors focus:border-accent" />

      <label class="mt-5 block text-sm font-medium" for="cf-contact">{t.form.contact}</label>
      <input id="cf-contact" name="contact" required
        class="mt-2 w-full rounded-lg border border-line bg-ink px-4 py-3 text-sm outline-none transition-colors focus:border-accent" />

      <label class="mt-5 block text-sm font-medium" for="cf-msg">{t.form.message}</label>
      <textarea id="cf-msg" name="message" rows="5" required placeholder={t.form.messagePlaceholder}
        class="mt-2 w-full resize-y rounded-lg border border-line bg-ink px-4 py-3 text-sm outline-none transition-colors placeholder:text-muted/60 focus:border-accent"></textarea>

      <button type="submit"
        class="mt-6 w-full rounded-full bg-accent px-6 py-3 text-sm font-semibold text-ink transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_10px_28px_-10px_var(--color-accent)] active:translate-y-0 active:scale-[0.98] active:duration-75">
        {t.form.submit}
      </button>
      <p class="mt-3 text-xs text-muted">{t.form.note}</p>
    </form>
  </div>
</section>

<script define:vars={{ email: site.email }}>
  document.getElementById('contactForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target;
    const subject = encodeURIComponent(`Website enquiry — ${f.name.value}`);
    const body = encodeURIComponent(
      `Name: ${f.name.value}\nContact: ${f.contact.value}\n\n${f.message.value}`
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
