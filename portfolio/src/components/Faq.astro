---
import SectionHead from './SectionHead.astro';
import { getContent, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = getContent(lang).faq;
---
<section id="faq" class="scroll-mt-20 border-t border-line py-24">
  <div class="container-x reveal">
    <SectionHead eyebrow={t.eyebrow} title={t.title} />
    <div class="mt-10 divide-y divide-line border-y border-line">
      {t.items.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-base font-semibold">
            {f.q}
            <span class="shrink-0 text-accent transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M9 3.5v11M3.5 9h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
          </summary>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
