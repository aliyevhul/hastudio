---
import SectionHead from './SectionHead.astro';
import { getContent, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = getContent(lang).work;
---
<section id="work" class="scroll-mt-20 py-24">
  <div class="container-x reveal">
    <SectionHead eyebrow={t.eyebrow} title={t.title} lede={t.lede} />
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {t.items.map((w) => (
        <article class="group flex flex-col rounded-2xl border border-line bg-surface p-7 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-accent hover:bg-surface-2 hover:shadow-[0_0_0_1px_var(--color-accent),0_16px_40px_-20px_var(--color-accent)]">
          <span class="self-start rounded-full border border-line px-2.5 py-1 text-[11px] font-medium uppercase tracking-wide text-muted">
            {w.tag}
          </span>
          <h3 class="mt-4 font-display text-xl font-extrabold tracking-tight">{w.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{w.body}</p>
          <p class="mt-5 flex items-center gap-2 text-sm font-semibold text-accent">
            <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>{w.result}
          </p>
          {w.href && (
            <a href={w.href} target="_blank" rel="noopener" class="mt-4 text-sm font-semibold underline underline-offset-4 hover:text-accent">
              {lang === 'az' ? 'Sayta bax' : 'Visit site'} →
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
