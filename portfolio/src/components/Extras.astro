---
import SectionHead from './SectionHead.astro';
import { getContent, type Lang } from '../i18n/content';
const { lang } = Astro.props as { lang: Lang };
const t = getContent(lang).extras;
---
<section id="design" class="scroll-mt-20 border-t border-line py-24">
  <div class="container-x reveal">
    <SectionHead eyebrow={t.eyebrow} title={t.title} lede={t.lede} />

    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
      {t.items.map((it) => (
        <div class="flex flex-col bg-surface p-7 relative transition-all duration-300 ease-out hover:z-10 hover:bg-surface-2 hover:ring-1 hover:ring-accent hover:shadow-[0_0_0_1px_var(--color-accent),0_16px_40px_-20px_var(--color-accent)]">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="font-display text-base font-bold">{it.name}</h3>
            <span class="shrink-0 font-display text-sm font-extrabold text-accent">{it.price}</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted">{it.body}</p>
        </div>
      ))}
    </div>

    <p class="mt-8 text-sm text-muted">{t.note}</p>
  </div>
</section>
