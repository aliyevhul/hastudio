---
const { eyebrow, title, lede } = Astro.props as { eyebrow: string; title: string; lede?: string };
---
<div class="max-w-2xl">
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">{eyebrow}</p>
  <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h2>
  {lede && <p class="mt-4 text-base leading-relaxed text-muted">{lede}</p>}
</div>
