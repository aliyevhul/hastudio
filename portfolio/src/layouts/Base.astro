---
import '../styles/global.css';
import { getContent, site, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getContent(lang);
// Astro hands BASE_URL back without a trailing slash under a subpath ("/hastudio"),
// but as "/" at the root. Normalise it so `${base}en/` is right in both cases.
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : `${raw}/`;
const azHref = base;
const enHref = `${base}en/`;
const otherHref = lang === 'az' ? enHref : azHref;
const homeHref = lang === 'az' ? azHref : enHref;

const navLinks = [
  { href: '#services', label: t.nav.services },
  { href: '#design', label: t.nav.design },
  { href: '#process', label: t.nav.process },
  { href: '#work', label: t.nav.work },
  { href: '#faq', label: t.nav.faq },
];
---

<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={new URL(homeHref, Astro.site)} />
    <link rel="alternate" hreflang="az" href={new URL(azHref, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap"
    />
    <!-- Critical, inline, and last in the head: guarantees the dark ground even
         before the stylesheet loads and regardless of any host reset. -->
    <style is:inline>
      html, body { background-color: #0b0c0e !important; color: #edecea; }
      :root { color-scheme: dark; }
    </style>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:font-semibold focus:text-ink"
      >{lang === 'az' ? 'Əsas məzmuna keç' : 'Skip to content'}</a
    >

    <header
      id="siteHeader"
      class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300"
    >
      <div class="container-x flex h-16 items-center justify-between gap-4">
        <a href={homeHref} class="group flex items-center gap-2.5 font-display text-[15px] font-extrabold tracking-tight">
          <span class="text-accent transition-transform duration-300 ease-out group-hover:-rotate-6">
            <svg viewBox="0 0 130 100" class="h-[18px] w-auto shrink-0" fill="currentColor" aria-hidden="true"><rect x="12" y="22" width="11" height="56"/><rect x="41" y="22" width="11" height="56"/><polygon points="84,22 93,22 69,78 58,78"/><polygon points="84,22 93,22 118,78 107,78"/><polygon points="12,44 102.82,44 107.73,55 12,55"/></svg>
          </span>
          {site.brand}<span class="text-accent">.</span>
        </a>

        <nav aria-label="Primary" class="hidden items-center gap-7 md:flex">
          {navLinks.map((l) => (
            <a
              href={l.href}
              class="text-sm text-muted transition-colors hover:text-paper"
            >{l.label}</a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={otherHref}
            aria-label={t.nav.switchLabel}
            class="lang-toggle rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-muted transition-all duration-200 ease-out hover:border-accent hover:bg-surface-2 hover:text-paper active:scale-95 active:duration-75"
            >{t.nav.switch}</a
          >
          <a
            href="#contact"
            class="hidden rounded-full bg-accent px-4 py-2 text-sm font-semibold text-ink transition-all duration-200 ease-out hover:-translate-y-px hover:shadow-[0_8px_20px_-10px_var(--color-accent)] active:translate-y-0 active:scale-[0.97] active:duration-75 sm:inline-block"
            >{t.nav.cta}</a
          >
          <button
            id="menuBtn"
            type="button"
            aria-expanded="false"
            aria-controls="mobileNav"
            aria-label="Menu"
            class="rounded-lg border border-line p-2 md:hidden"
          >
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mobileNav" hidden class="border-t border-line bg-surface md:hidden">
        <nav aria-label="Mobile" class="container-x flex flex-col py-2">
          {navLinks.map((l) => (
            <a href={l.href} class="border-b border-line/60 py-3 text-sm text-paper last:border-0">{l.label}</a>
          ))}
          <a href="#contact" class="py-3 text-sm font-semibold text-accent">{t.nav.cta}</a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="border-t border-line py-10">
      <div class="container-x flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="flex items-center gap-2.5 font-display text-sm font-extrabold">
            <span class="text-accent"><svg viewBox="0 0 130 100" class="h-[18px] w-auto shrink-0" fill="currentColor" aria-hidden="true"><rect x="12" y="22" width="11" height="56"/><rect x="41" y="22" width="11" height="56"/><polygon points="84,22 93,22 69,78 58,78"/><polygon points="84,22 93,22 118,78 107,78"/><polygon points="12,44 102.82,44 107.73,55 12,55"/></svg></span>{site.brand}<span class="text-accent">.</span>
          </p>
          <p class="mt-1 text-sm text-muted">{t.footer.tagline}</p>
        </div>
        <div class="flex flex-col gap-1 text-sm text-muted sm:items-end">
          <a href={`mailto:${site.email}`} class="transition-colors hover:text-paper">{site.email}</a>
          <a href={`tel:${site.phoneHref}`} class="transition-colors hover:text-paper">{site.phone}</a>
        </div>
      </div>
      <div class="container-x mt-8 flex flex-col gap-2 border-t border-line pt-6 text-xs text-muted sm:flex-row sm:justify-between">
        <p>© {new Date().getFullYear()} {site.brand}. {t.footer.rights}</p>
        <p>{t.footer.built}</p>
      </div>
    </footer>

    <script>
      // Sticky header gets a background once you scroll past the hero edge.
      const header = document.getElementById('siteHeader');
      const onScroll = () => {
        header?.classList.toggle('bg-ink/85', window.scrollY > 8);
        header?.classList.toggle('backdrop-blur', window.scrollY > 8);
        header?.classList.toggle('border-line', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Mobile menu.
      const btn = document.getElementById('menuBtn');
      const panel = document.getElementById('mobileNav');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        if (panel) panel.hidden = open;
      });
      panel?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          btn?.setAttribute('aria-expanded', 'false');
          if (panel) panel.hidden = true;
        })
      );

      // Language switch: carry the section you are reading across to the other
      // language, so AZ -> EN drops you back where you were instead of at the top.
      document.querySelector('.lang-toggle')?.addEventListener('click', (e) => {
        const link = e.currentTarget as HTMLAnchorElement;
        let current = '';
        document.querySelectorAll('section[id]').forEach((sec) => {
          if (sec.getBoundingClientRect().top <= 120) current = sec.id;
        });
        if (current) link.href = link.getAttribute('href')!.split('#')[0] + '#' + current;
      });

      // Scroll reveal.
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).style.opacity = '1';
              (e.target as HTMLElement).style.transform = 'none';
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
